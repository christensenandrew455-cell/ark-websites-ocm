# Firebase Web SDK values (public; used by browser and APK WebView)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Hosted application origin. Keep this aligned with capacitor.config.json.
NEXT_PUBLIC_APP_URL=https://your-current-app-domain.com

# Public ARK Client Center support/report page used by messaging compliance flows.
ARK_CLIENT_CENTER_SUPPORT_URL=https://arkwebsites.com/support

# Firebase Admin service account values (server-only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Signed operational events forwarded to ARK Admin. The same secret also
# verifies number-assignment events sent back to /api/webhooks/admin.
ARK_ADMIN_WEBHOOK_URL=https://ark-admin-app.vercel.app/api/webhooks/events
ARK_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_live_or_test_secret
# Optional overrides for the four monthly recurring Prices. Each must be an active USD
# monthly flat-rate Price with the exact amount shown. Leave any value blank to let the
# server find or create its code-managed Price in the current Stripe test/live mode.
# Starter: $49.99 / 50 calls
STRIPE_STARTER_PRICE_ID=
# Standard: $79.99 / 100 calls
STRIPE_STANDARD_PRICE_ID=
# Growth: $149.99 / 250 calls
STRIPE_GROWTH_PRICE_ID=
# Pro: $299.99 / 500 calls
STRIPE_PRO_PRICE_ID=

# Apple In-App Purchase (iOS only). APPLE_IAP_APPLE_ID is the numeric Apple ID
# shown under App Information in App Store Connect, not the bundle ID.
APPLE_IAP_APPLE_ID=
APPLE_IAP_PLAN_PRODUCT_ID_STARTER=com.arkwebsites.app.starter.monthly
APPLE_IAP_PLAN_PRODUCT_ID_STANDARD=com.arkwebsites.app.standard.monthly
APPLE_IAP_PLAN_PRODUCT_ID_GROWTH=com.arkwebsites.app.growth.monthly
APPLE_IAP_PLAN_PRODUCT_ID_PRO=com.arkwebsites.app.pro.monthly

# Separate scheduled workflows; these are not Stripe signup requirements.
CRON_SECRET=
OCM_REMINDER_SECRET=

# Telnyx messaging
TELNYX_API_KEY=KEY_your_telnyx_api_key
TELNYX_PUBLIC_KEY=

# One central Telnyx number sends signup verification and number-ready texts.
TELNYX_SIGNUP_FROM_NUMBER=+17742316164

# Resend sends the separate signup email verification code.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ARK Client Center <accounts@your-verified-domain.com>
ACCOUNT_VERIFICATION_SECRET=replace-with-a-long-random-server-secret
# Optional fallback secret for inbound messaging requests that do not use Telnyx signature verification.
ARK_MESSAGING_INBOUND_SECRET=

# Android builds also require this GitHub Actions secret (not a Vercel environment variable):
# FIREBASE_ANDROID_GOOGLE_SERVICES_JSON = the complete google-services.json file contents
