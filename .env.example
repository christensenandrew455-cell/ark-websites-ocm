# Firebase Web SDK values (public; used by browser and APK WebView)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Hosted application origin. Keep this aligned with capacitor.config.json.
NEXT_PUBLIC_APP_URL=https://your-current-app-domain.com

# Public ARK Client Center support/report page used by messaging compliance flows.
ARK_CLIENT_CENTER_SUPPORT_URL=https://arkwebsites.com/support

# Firebase Admin service account values (server-only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Signed operational events forwarded to the separate Arc Admin backend.
# Both values are server-only. Use the identical high-entropy secret there.
ARC_ADMIN_WEBHOOK_URL=https://ark-admin-app.vercel.app/api/webhooks/events
ARC_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
# Optional temporary override for the monthly signup Price. It must be an active USD monthly
# recurring flat-rate Price in the same test/live mode as the Stripe keys. Leave it blank to
# make the server find or create the normal $50 monthly Price from the code constants.
STRIPE_ACCOUNT_BASE_PRICE_ID=
# Active one-time $20 USD flat-rate Price for each completed usage threshold.
STRIPE_USAGE_PRICE_ID=
# No Product ID, webhook, domain, or home-path variable is required for signup.

# Separate scheduled workflows; these are not Stripe signup requirements.
CRON_SECRET=
OCM_REMINDER_SECRET=

# Telnyx messaging
TELNYX_API_KEY=KEY_your_telnyx_api_key
TELNYX_PUBLIC_KEY=

# One central Telnyx number sends signup verification and number-ready texts.
TELNYX_SIGNUP_FROM_NUMBER=+17742316164

# Resend sends the separate signup email verification code.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ARK Client Center <accounts@your-verified-domain.com>
ACCOUNT_VERIFICATION_SECRET=replace-with-a-long-random-server-secret

# Optional fallback secret for inbound messaging requests that do not use Telnyx signature verification.
ARK_MESSAGING_INBOUND_SECRET=

# Android builds also require this GitHub Actions secret (not a Vercel environment variable):
# FIREBASE_ANDROID_GOOGLE_SERVICES_JSON = the complete google-services.json file contents
