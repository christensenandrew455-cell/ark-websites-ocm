# Firebase Web SDK values (public; used by browser and APK WebView)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Hosted application origin. Keep this aligned with capacitor.config.json.
NEXT_PUBLIC_APP_URL=https://ark-websites-ocm-xi.vercel.app

# Public ARK Client Center support/report page used by messaging compliance flows.
ARK_CLIENT_CENTER_SUPPORT_URL=https://arkwebsites.com/support

# Firebase Admin service account values (server-only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Administrator access and ARK's internal customer workspace
ADMIN_EMAILS=owner@example.com
ARK_ADMIN_CLIENT_ID=ark-ocm

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_webhook_signing_secret
YOUR_DOMAIN=https://ark-websites-ocm-xi.vercel.app
APP_HOME_PATH=/

# Recurring and metered Stripe price IDs used outside the signup SetupIntent.
STRIPE_ACCOUNT_PRODUCT_ID=prod_V30kc7tD7n7F
STRIPE_ACCOUNT_BASE_PRICE_ID=
STRIPE_ACCOUNT_LEAD_PRICE_ID=
STRIPE_ACCOUNT_CHAT_PRICE_ID=
STRIPE_ACCOUNT_MESSAGE_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Scheduled server workflows. Generate long random values and use matching values in GitHub Actions secrets.
CRON_SECRET=
OCM_REMINDER_SECRET=
BILLING_WORKFLOW_SECRET=

# Telnyx messaging
TELNYX_API_KEY=KEY_your_telnyx_api_key
TELNYX_PUBLIC_KEY=

# One central Telnyx number sends signup verification and number-ready texts.
TELNYX_SIGNUP_FROM_NUMBER=+17742316164

# Resend sends the separate signup email verification code.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ARK Client Center <accounts@your-verified-domain.com>

# Optional fallback secret for inbound messaging requests that do not use Telnyx signature verification.
ARK_MESSAGING_INBOUND_SECRET=

# Android builds also require this GitHub Actions secret (not a Vercel environment variable):
# FIREBASE_ANDROID_GOOGLE_SERVICES_JSON = the complete google-services.json file contents
