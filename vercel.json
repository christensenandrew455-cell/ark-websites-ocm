{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/billing-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/message-retention",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/workflow",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/workflows/billing-enforcement",
      "schedule": "45 5 * * *"
    }
  ]
}
