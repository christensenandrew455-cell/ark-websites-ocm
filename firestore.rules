rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == "admin";
    }

    function isOwner(clientId) {
      return signedIn()
        && request.auth.token.role == "standard"
        && request.auth.token.clientId == clientId;
    }

    function isActiveOwner(clientId) {
      return isOwner(clientId)
        && (!('identityVerificationRequired' in request.auth.token)
          || request.auth.token.identityVerificationRequired == false
          || request.auth.token.identityVerificationVerified == true)
        && (!('accountStatus' in request.auth.token)
          || request.auth.token.accountStatus == "active");
    }

    function isOwnerManagedCollection(collectionId) {
      return collectionId == "contactedMe" || collectionId == "clients";
    }

    match /accounts/{clientId} {
      allow get: if isAdmin() || isOwner(clientId);
      allow list: if isAdmin();
      allow write: if false;

      match /{collectionId}/{document=**} {
        allow read, write: if collectionId != "private"
          && (isAdmin()
            || (isActiveOwner(clientId) && isOwnerManagedCollection(collectionId)));
      }
    }

    match /pendingOwnerSignups/{clientId} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
