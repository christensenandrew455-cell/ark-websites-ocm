rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(clientId) {
      return signedIn()
        && request.auth.token.role == "standard"
        && request.auth.token.clientId == clientId;
    }

    match /accounts/{clientId} {
      allow get: if isOwner(clientId);
      allow write: if false;

      match /{collectionId}/{document=**} {
        allow read, write: if false;
      }
    }

    match /pendingOwnerSignups/{clientId} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
