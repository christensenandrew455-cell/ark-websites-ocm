{
  "name": "ark-websites-ocm",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.*",
    "mobile:android:setup": "node scripts/setup-android.mjs",
    "mobile:android:add": "npm run mobile:android:setup",
    "mobile:android:sync": "npm run mobile:android:setup",
    "mobile:android:open": "npm run mobile:android:setup && npx cap open android",
    "mobile:ios:add": "npx cap add ios && node scripts/generate-ios-icon.mjs && node scripts/configure-ios.mjs && node scripts/configure-orientation.mjs",
    "mobile:ios:sync": "npx cap sync ios && node scripts/generate-ios-icon.mjs && node scripts/configure-ios.mjs && node scripts/configure-orientation.mjs",
    "mobile:ios:open": "npm run mobile:ios:sync && npx cap open ios",
    "mobile:verify": "node scripts/verify-mobile-release.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor-community/contacts": "7.2.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/push-notifications": "8.1.2",
    "@ebarooni/capacitor-calendar": "8.2.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/postcss": "4.3.3",
    "firebase": "12.16.0",
    "firebase-admin": "13.6.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0"
  }
}
